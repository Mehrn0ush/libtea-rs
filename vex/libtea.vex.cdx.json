      "cwes": [674],
      "description": "Stack overflow in url::Url::origin() on nested blob: URLs (url <= 2.5.8).",
      "published": "2026-11-20T00:00:00Z",
      "analysis": {
        "state": "not_affected",
        "justification": "code_not_reachable",
        "detail": "The libtea-cli 0.2.2 release binaries are built with url 2.5.8. The advisory affects only url::Url::origin() and url::quirks::origin(). Nothing in the binary calls either: not libtea-core 0.2.0, libtea-client 0.2.0 or libtea-cli 0.2.2, and not reqwest 0.12.28 or tower-http 0.6.11, the other crates in its tree that depend on url (checked in the sources at tag v0.2.2). libtea-core and libtea-client do not call it either; applications that use them resolve their own url version and should update to 2.5.9 if their own code calls Url::origin(). main uses url 2.5.9 from #89.",
        "firstIssued": "2026-11-23T00:00:00Z",
        "lastUpdated": "2026-11-23T00:00:00Z"
      },
      "affects": [
        {
          "ref": "libtea-cli@0.2.2",
          "versions": [{ "version": "0.2.2", "status": "unaffected" }]
